{
  "name": "negent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute negent-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute negent-db --remote --file=schema.sql",
    "migrate:local": "wrangler d1 execute negent-db --local --file=migration_001_category_score.sql",
    "migrate:remote": "wrangler d1 execute negent-db --remote --file=migration_001_category_score.sql",
    "seed:local": "wrangler d1 execute negent-db --local --file=seed.sql",
    "seed:remote": "wrangler d1 execute negent-db --remote --file=seed.sql",
    "cleanup:remote": "wrangler d1 execute negent-db --remote --command \"DELETE FROM articles WHERE fetched_at < datetime('now', '-48 hours') AND (status IN ('done', 'failed') OR delivered = 1)\"",
    "purge:remote": "wrangler d1 execute negent-db --remote --command \"DELETE FROM articles; DELETE FROM delivery_log;\"",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "allowScripts": {
    "workerd@1.20260701.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
